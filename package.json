		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.6.5",
		"linkedom": "^0.18.13",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amdlift/onepace-dl.git"
